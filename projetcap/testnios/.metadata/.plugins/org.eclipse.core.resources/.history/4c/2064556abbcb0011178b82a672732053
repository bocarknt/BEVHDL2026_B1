#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "unistd.h" // Pour usleep
#include "io.h"     // Indispensable pour IOWR

// Définition des adresses de base
#define CAP_BASE_ADDR CAP_0_BASE

int main() {
    printf("=== Démarrage du système PWM -> Boussole (CAP) ===\n");

    // 1. CONFIGURATION ET LANCEMENT DU PWM (Essentiel pour générer le signal !)
    // PWM_BASE : Adresse 0 = Fréquence, Adresse 1 = Duty Cycle, Adresse 2 = Control
    IOWR(PWM_BASE, 0, 50000);  // Fréquence / Période
    IOWR(PWM_BASE, 1, 25000);  // Rapport cyclique à 50%
    IOWR(PWM_BASE, 2, 0x3);    // Activation du PWM (Enable + Run)
    printf("PWM démarré avec succès !\n");

    // 2. CONFIGURATION DE LA BOUSSOLE (CAP)
    // Pointeur vers le registre de contrôle (Adresse 0)
    volatile alt_u32* const cap_ctrl = (alt_u32*) CAP_BASE_ADDR;
    // Pointeur vers le registre de données de la boussole (Adresse 1 / +4 octets)
    volatile alt_u32* const cap_valeur = (alt_u32*) (CAP_BASE_ADDR + 4);

    // Force le mode continu pour que la boussole actualise la mesure
    *cap_ctrl = 0x3;
    printf("CAP activé en mode continu !\n");

    while(1) {
        // 3. Lecture de la valeur mesurée par le CAP
        alt_u32 valeur_boussole = *cap_valeur;

        // 4. Affichage de la valeur dans la console Nios II
        printf("Valeur lue de la boussole : %lu\n", (unsigned long)valeur_boussole);

        // Pause d'une demi-seconde
        usleep(500000);
    }

    return 0;
}
