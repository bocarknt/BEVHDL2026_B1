#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "io.h"

#define CAP_BASE_ADDR CAP_0_BASE

int main() {
    IOWR(PWM_BASE, 0, 50000);
    IOWR(PWM_BASE, 1, 25000);
    IOWR(PWM_BASE, 2, 0x3);

    int mode_precedent = -1;
    int bouton_precedent = 0;

    while(1) {
        alt_u32 etat_switches = IORD(0x00003020, 0) & 0x1;
        alt_u32 etat_bouton   = IORD(0x00003030, 0) & 0x1;

        if (etat_switches == 1) {
            if (mode_precedent != 1) {
                IOWR(CAP_BASE_ADDR, 0, 0x3);
                mode_precedent = 1;
            }
            alt_u32 valeur_boussole = IORD(CAP_BASE_ADDR, 1);
            printf("Cap: %lu\n", (unsigned long)valeur_boussole);
        } else {
            if (mode_precedent != 0) {
                IOWR(CAP_BASE_ADDR, 0, 0x1);
                mode_precedent = 0;
            }

            if (etat_bouton == 1 && bouton_precedent == 0) {
                IOWR(CAP_BASE_ADDR, 0, 0x5);

                volatile int t = 500000;
                while(t > 0) { t--; }

                IOWR(CAP_BASE_ADDR, 0, 0x1);

                volatile int wait_mesure = 500000;
                while(wait_mesure > 0) { wait_mesure--; }

                alt_u32 valeur_unique = IORD(CAP_BASE_ADDR, 1);
                printf("Unique: %lu\n", (unsigned long)valeur_unique);
            }
        }
        bouton_precedent = etat_bouton;

        volatile int temps = 200000;
        while(temps > 0) { temps--; }
    }
    return 0;
}
