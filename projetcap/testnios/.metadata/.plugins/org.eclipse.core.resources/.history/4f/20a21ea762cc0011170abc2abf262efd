#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "io.h"

#ifndef SWITCH_BASE
#define SWITCH_BASE 0x3020
#endif

#define CAP_BASE_ADDR CAP_0_BASE

int main() {
    printf("=== SYSTEME BOUSSOLE DEMARRE ===\n");

    // 1. Configuration initiale du PWM
    IOWR(PWM_BASE, 0, 50000);
    IOWR(PWM_BASE, 1, 25000);
    IOWR(PWM_BASE, 2, 0x3);

    int mode_precedent = -1;
    int bouton_precedent = 0;

    while(1) {
        alt_u32 etat_switches = IORD(SWITCH_BASE, 0) & 0x1;
        alt_u32 etat_bouton = IORD(BOUTON_BASE, 0) & 0x1;

        if (etat_switches == 1) {
            if (mode_precedent != 1) {
                IOWR(CAP_BASE_ADDR, 0, 0x3); // Mode Continu
                printf("\n[MODE] Continu active\n");
                mode_precedent = 1;
            }
        } else {
            if (mode_precedent != 0) {
                IOWR(CAP_BASE_ADDR, 0, 0x1); // Mode Monocoup
                printf("\n[MODE] Monocoup active\n");
                mode_precedent = 0;
            }

            if (etat_bouton == 1 && bouton_precedent == 0) {
                printf("\n[ACTION] Impulsion START\n");
                IOWR(CAP_BASE_ADDR, 0, 0x5); // Start = 1

                volatile int t = 100000;
                while(t > 0) { t--; }

                IOWR(CAP_BASE_ADDR, 0, 0x1); // Start = 0
            }
        }
        bouton_precedent = etat_bouton;

        // 3. Lecture et affichage de la valeur mesurée de la boussole (Offset 1)
        alt_u32 valeur_boussole = IORD(CAP_BASE_ADDR, 1);
        printf("Cap / Valeur lue : %lu\n", (unsigned long)valeur_boussole);

        // Petite attente pour stabiliser l'affichage dans la console
        volatile int temps = 500000;
        while(temps > 0) { temps--; }
    }

    return 0;
}
