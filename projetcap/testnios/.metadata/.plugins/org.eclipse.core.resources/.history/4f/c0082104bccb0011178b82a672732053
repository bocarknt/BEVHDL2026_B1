#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "unistd.h"
#include "io.h"

int main() {
    printf("=== Démarrage du système PWM -> Boussole (CAP) ===\n");

    // Pointeurs de base
    volatile alt_u32* const cap_ctrl   = (alt_u32*) CAP_0_BASE;
    volatile alt_u32* const cap_valeur = (alt_u32*) (CAP_0_BASE + 4);

    // Configuration initiale du PWM
    IOWR(PWM_BASE, 0, 50000);  // Fréquence
    IOWR(PWM_BASE, 1, 25000);  // Duty 50%
    IOWR(PWM_BASE, 2, 0x3);    // Run + Enable
    printf("PWM démarré avec succès !\n");

    // Configuration initiale du CAP
    *cap_ctrl = 0x3;
    printf("CAP activé en mode continu !\n");

    while(1) {
        // Lecture de la valeur
        alt_u32 valeur_boussole = *cap_valeur;

        // Affichage
        printf("Valeur lue de la boussole : %lu\n", (unsigned long)valeur_boussole);

        usleep(500000);
    }

    return 0;
}
