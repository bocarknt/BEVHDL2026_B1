#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "io.h"

#define CAP_BASE_ADDR CAP_0_BASE

int main() {
    // Configuration initiale du PWM
    IOWR(PWM_BASE, 0, 50000);
    IOWR(PWM_BASE, 1, 25000);
    IOWR(PWM_BASE, 2, 0x3);

    printf("=== BOUSSOLE DEMARREE ===\n");

    int mode_precedent = -1;
    int bouton_precedent = 0;

    while(1) {
        alt_u32 etat_switches = IORD(0x00003020, 0) & 0x1;
        // Lecture de KEY1 (bit 1 -> masque 0x2)
        alt_u32 etat_bouton   = (IORD(0x00003030, 0) & 0x2) ? 1 : 0;

        if (etat_switches == 1) {
            // --- MODE CONTINU ---
            if (mode_precedent != 1) {
                IOWR(CAP_BASE_ADDR, 0, 0x3); // b1=1 (continu)[cite: 6]
                printf("Mode: Continu\n");
                mode_precedent = 1;
            }

            alt_u32 reg_compas = IORD(CAP_BASE_ADDR, 1);
            int valid = (reg_compas >> 9) & 0x1; // b9 = valid[cite: 6]
            int cap   = reg_compas & 0x1FF;      // b8..b0 = cap[cite: 6]

            printf("Cont - V:%d | Cap:%d\n", valid, cap);

            for(volatile int t = 2000000; t > 0; t--);

        } else {
            // --- MODE MONOCOUP ---
            if (mode_precedent != 0) {
                IOWR(CAP_BASE_ADDR, 0, 0x1); // b1=0 (monocoup)[cite: 6]
                printf("Mode: Monocoup (KEY1)\n");
                mode_precedent = 0;
            }

            if (etat_bouton == 1 && bouton_precedent == 0) {
                printf("Appui KEY1 -> Mesure\n");

                // Start = 1 (b2=1, b1=0, b0=1 -> 0x5)[cite: 6]
                IOWR(CAP_BASE_ADDR, 0, 0x5);

                for(volatile int t = 500000; t > 0; t--);

                // Start = 0 (b2=0, b1=0, b0=1 -> 0x1)[cite: 6]
                IOWR(CAP_BASE_ADDR, 0, 0x1);

                for(volatile int wait = 1000000; wait > 0; wait--);

                alt_u32 reg_compas = IORD(CAP_BASE_ADDR, 1);
                int valid = (reg_compas >> 9) & 0x1;
                int cap   = reg_compas & 0x1FF;

                printf("Mono - V:%d | Cap:%d\n", valid, cap);
            }
        }
        bouton_precedent = etat_bouton;

        for(volatile int temps = 100000; temps > 0; temps--);
    }
    return 0;
}
