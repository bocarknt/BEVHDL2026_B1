#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "unistd.h" // Pour usleep

#define CAP_BASE_ADDR   CAP_0_BASE
#define PWM_BASE_ADDR   PWM_BASE

int main() {
    printf("Démarrage du test PWM -> CAP !\n");

    // Pointeurs pour le bloc CAP (Boussole)
    volatile alt_u32* const cap_ctrl   = (alt_u32*) CAP_BASE_ADDR;
    volatile alt_u32* const cap_valeur = (alt_u32*) (CAP_BASE_ADDR + 4);

    // Pointeurs pour le bloc PWM (Basé sur votre VHDL : adresses 00=freq, 01=duty, 10=control)
    volatile alt_u32* const pwm_freq    = (alt_u32*) PWM_BASE_ADDR;
    volatile alt_u32* const pwm_duty    = (alt_u32*) (PWM_BASE_ADDR + 4);
    volatile alt_u32* const pwm_control = (alt_u32*) (PWM_BASE_ADDR + 8);

    // 1. Configuration du PWM (Génération d'un signal carré)
    // Horloge à 50 MHz : Période = 50000, Rapport cyclique = 25000 (50%)
    *pwm_freq = 50000;
    *pwm_duty = 25000;

    // Activation du PWM (Bit 0 = enable, Bit 1 = run) -> 0x3
    *pwm_control = 0x3;
    printf("PWM configuré et démarré !\n");

    // 2. Configuration du CAP en mode continu
    // Bit 0 = 1 (continu), Bit 1 = 1 (start_stop)
    *cap_ctrl = 0x3;

    while(1) {
        // 3. Lecture de la valeur mesurée par le CAP
        alt_u32 valeur_boussole = *cap_valeur;

        // 4. Affichage de la valeur dans la console
        printf("Valeur lue du CAP : %lu\n", (unsigned long)valeur_boussole);

        // Pause d'une demi-seconde
        usleep(500000);
    }

    return 0;
}
