#include <stdio.h>
#include "system.h"
#include "alt_types.h"
#include "unistd.h"
#include "io.h" // Nécessaire pour IOWR et IOREAD

int main() {
    printf("=== Debut du programme PWM -> CAP ===\n");

    // 1. Configuration du PWM via IOWR
    // PWM_BASE : Adresse 0 = freq, Adresse 4 = duty, Adresse 8 = control
    IOWR(PWM_BASE, 0, 50000);  // Fréquence
    IOWR(PWM_BASE, 1, 25000);  // Duty (50%)
    IOWR(PWM_BASE, 2, 0x3);    // Control (Enable + Run)
    printf("PWM active !\n");

    // 2. Configuration du CAP via IOWR
    // CAP_0_BASE : Adresse 0 = control (continu + start)
    IOWR(CAP_0_BASE, 0, 0x3);
    printf("CAP active en mode continu !\n");

    while(1) {
        // 3. Lecture de la valeur mesurée sur le CAP (Adresse 4)
        alt_u32 valeur_boussole = IOREAD(CAP_0_BASE, 1);

        printf("Valeur lue du CAP : %lu\n", (unsigned long)valeur_boussole);

        usleep(500000); // Pause de 500ms
    }

    return 0;
}
